rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // STAN OBECNY (produkcja) = w pełni otwarte.
    // DO ZAOSTRZENIA w Fazie 2 (security pass) — reguły świadome członkostwa,
    // podsumowania tylko z Cloud Function, brak kasowania cudzego.
    match /artifacts/{appId}/public/data/{document=**} {
      allow read, write: if true;
    }
  }
}
