rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kto REALNIE stoi za danym członkiem grupy. Sesja (uid) przypisuje się do członka
    // przez `claimedBy` przy dołączaniu — to jedyny most między tożsamością a imieniem
    // z listy. Reguły muszą go czytać, inaczej „odbiorca potwierdza wpłatę" jest tylko
    // uprzejmą sugestią interfejsu, a nie zasadą.
    // Koszt: jeden odczyt dokumentu grupy na sprawdzenie (Firestore je nalicza).
    function memberOwner(appId, groupId, memberId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/groups/$(groupId))
               .data.members[memberId].claimedBy;
    }

    match /artifacts/{appId}/public/data/groups/{groupId} {
      // Odczyt: każdy zalogowany, kto ma link (ID grupy = klucz dostępu).
      allow read: if request.auth != null;

      // Tworzenie grupy: zalogowany, i musi być adminem tworzonej grupy.
      allow create: if request.auth != null
                    && request.resource.data.adminId == request.auth.uid;

      // Aktualizacja: zalogowany, ale NIE wolno ruszać pól podsumowań —
      // te zapisuje WYŁĄCZNIE Cloud Function (admin SDK omija reguły).
      // To broni bilansów przed sfałszowaniem z klienta.
      // `adminId` też jest zamrożony: to on decyduje, kto utworzył grupę, więc przejęcie
      // go byłoby przejęciem grupy.
      allow update: if request.auth != null
                    && !request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasAny(['expenseSummary', 'userGrossSpend', 'groupGrossSpend'])
                    && request.resource.data.adminId == resource.data.adminId;

      // Grupy nie kasujemy z klienta.
      allow delete: if false;

      // Rachunki w grupie: odczyt/tworzenie/edycja dla zalogowanych (członków z linkiem).
      // USUNIĘCIE jest inne: rachunek z potwierdzonym płatnikiem może skasować tylko ten
      // płatnik. Interfejs tego pilnował od dawna („Tylko potwierdzony płatnik może usunąć"),
      // reguły — nie, więc dowolny uczestnik mógł skasować cudzy rachunek z konsoli
      // i wyzerować komuś należność. Rachunek bez płatnika jest niczyj → kasuje każdy.
      match /bills/{billId} {
        allow read, create, update: if request.auth != null;
        allow delete: if request.auth != null
                      && (resource.data.payerId == null
                          || memberOwner(appId, groupId, resource.data.payerId) == request.auth.uid);
      }

      // Wpłaty (rejestr spłat): każdy zalogowany może dodać/odczytać.
      // Aktualizacja TYLKO pól potwierdzenia (odbiorca potwierdza; kwoty/stron nie ruszamy).
      // Usunąć może tylko twórca wpłaty (undo własnej pomyłki).
      match /settlements/{settlementId} {
        allow read, create: if request.auth != null;
        // Potwierdzić wpłatę może TYLKO jej odbiorca. Wcześniej mógł to zrobić każdy
        // zalogowany — także dłużnik na własnej wpłacie — czyli znaczek „potwierdzona"
        // nie znaczył nic. W aplikacji o cudzych pieniądzach to podważa jedyny mechanizm
        // zaufania, jaki tu jest.
        //
        // KAŻDĄ ODPOWIEDŹ PISZE INNA STRONA i to jest tu najważniejsze. Odpowiedź na
        // zgłoszony przelew ma dwa kierunki („mam" / „nie widzę") i dwie rundy, więc bez
        // rozdziału ról nadawca mógłby sam sobie potwierdzić wpłatę albo zdjąć cudzy spór —
        // czyli znaczek znów nie znaczyłby nic.
        //
        //   ODBIORCA (`to`)  — confirmed / disputed / stalled: to on trzyma konto i tylko
        //                      on może powiedzieć, czy pieniądze doszły.
        //   NADAWCA (`from`) — insisted / withdrawn: to on wie, czy przelew wyszedł.
        //
        // Kwoty, stron i rachunków nie rusza NIKT — te pola nie są tu wymienione, więc
        // każda próba ich zmiany odbija się o `hasOnly`.
        allow update: if request.auth != null
                      && request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasOnly(['confirmed', 'confirmedBy', 'confirmedAt',
                                      'disputed', 'disputedBy', 'disputedAt', 'stalled'])
                      && memberOwner(appId, groupId, resource.data.to) == request.auth.uid
                      // POTWIERDZONA I SPORNA NARAZ TO STAN NIEMOŻLIWY. Saldo czyta oba pola
                      // (`settlementCountsInLedger`), więc taki dokument znaczyłby dwie
                      // sprzeczne rzeczy o tych samych pieniądzach. Interfejs zawsze gasi
                      // jedno przy zapalaniu drugiego — reguła pilnuje tego samego, żeby
                      // zapis z konsoli nie mógł stworzyć czegoś, czego ekran nie umie pokazać.
                      && !(request.resource.data.get('confirmed', false) == true
                           && request.resource.data.get('disputed', false) == true);
        // Nadawca odpowiada na spór: podtrzymuje zgłoszenie albo je wycofuje. Nie może
        // przy tym ruszyć ani potwierdzenia, ani cudzej odmowy — to nie jego pola.
        allow update: if request.auth != null
                      && request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasOnly(['insisted', 'insistedAt', 'withdrawn', 'withdrawnAt'])
                      && memberOwner(appId, groupId, resource.data.from) == request.auth.uid;
        // Usunąć wpis może TYLKO jego autor i TYLKO dopóki odbiorca go nie potwierdził
        // (decyzja właściciela 2026-08-15). To jest naprawa własnej pomyłki sprzed minuty,
        // a nie kasowanie historii: po potwierdzeniu wpłata jest dowodem dla obu stron
        // i znika wyłącznie wpłatą w drugą stronę. Interfejs pokazuje kosz na dokładnie
        // tych samych warunkach, więc reguła i ekran mówią to samo.
        // `get('confirmed', false)`, a nie `resource.data.confirmed` (audyt 2026-08-16):
        // odwołanie WPROST do brakującego pola nie daje `null`, tylko wywala regułę błędem
        // wykonania, a błąd znaczy odmowę. Pole `confirmed` dokładamy przy tworzeniu wpłaty
        // dopiero od 2026-08-15, więc każda WCZEŚNIEJSZA wpłata była nie do skasowania przez
        // własnego autora — i to bez czytelnego powodu, bo interfejs pokazywał kosz.
        allow delete: if request.auth != null
                      && resource.data.createdBy == request.auth.uid
                      && resource.data.get('confirmed', false) != true;
      }

      // Przypomnienia (nudge-windykator): zalogowany tworzy jako on sam (createdBy=uid), każdy zalogowany czyta.
      // Aktualizacja TYLKO pola readBy (odbiorca oznacza „przeczytane"); reszta danych niezmienna.
      // Usunąć może tylko twórca przypomnienia.
      match /nudges/{nudgeId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.createdBy == request.auth.uid;
        // „Przeczytane" oznacza tylko adresat — inaczej ktokolwiek mógł zdjąć cudzą
        // plakietkę nieprzeczytanego przypomnienia i uciszyć windykatora.
        allow update: if request.auth != null
                      && request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasOnly(['readBy'])
                      && memberOwner(appId, groupId, resource.data.to) == request.auth.uid;
        allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
      }

      // Aktywność: dziennik zdarzeń pokoju (kto zmienił kwotę, kto co odkliknął,
      // kto dopisał osobę). Przy grupie 12–25 osób to mechanizm zaufania, a nie
      // ozdoba — więc jest DOPISYWALNY, ale NIEZMIENNY: wpis raz zapisany nie da się
      // ani poprawić, ani skasować z klienta. Dziennik, który da się wyczyścić,
      // nie jest dziennikiem.
      match /events/{eventId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Wszystko inne — zamknięte (domyślny deny, jawnie dla czytelności).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
